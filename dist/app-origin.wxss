page{background:#fbf8f3;color:#2d2a26;font-family:-apple-system,BlinkMacSystemFont,Helvetica Neue,PingFang SC,Hiragino Sans GB,Microsoft YaHei,sans-serif;font-size:28rpx;line-height:1.5}.page{padding:28rpx 48rpx 96rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06)}.sec-head{align-items:center;display:flex;justify-content:space-between;margin:40rpx 0 24rpx}.sec-head .bar{background:#ff8a5c;border-radius:4rpx;display:inline-block;height:32rpx;margin-right:16rpx;width:8rpx}.sec-head .label{color:#2d2a26;font-size:30rpx;font-weight:900;letter-spacing:1rpx}.sec-head .more{color:#ff7a45;font-size:24rpx;font-weight:700}.page-title{color:#2d2a26;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:40rpx;font-weight:900}.page-sub{color:#a89f92;font-size:22rpx;margin-top:6rpx}.tag{align-items:center;border-radius:9999rpx;display:inline-flex;font-size:19rpx;font-weight:800;margin-right:12rpx;padding:8rpx 20rpx}.tag.easy{background:#e8f6ee;color:#4caf7d}.tag.mid{background:#fff3e0;color:#ff9f43}.tag.hard{background:#ffe9e9;color:#ff5d5d}.tag.kp{background:#f5f1ea;color:#8a8072}.tag.ai-gen{background:#fff0e8;color:#ff7a45}.chips{display:flex;flex-wrap:wrap;gap:16rpx}.chip{background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;font-size:22rpx;font-weight:700;padding:16rpx 32rpx}.chip.on{background:#ff8a5c;color:#fff}