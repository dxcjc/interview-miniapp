page{background:#fbf8f3;color:#2d2a26;font-family:-apple-system,BlinkMacSystemFont,Helvetica Neue,PingFang SC,Hiragino Sans GB,Microsoft YaHei,sans-serif;font-size:28rpx;line-height:1.5;-webkit-tap-highlight-color:transparent}button{background:none;border:none;border-radius:0;color:inherit;font-family:inherit;font-size:inherit;line-height:inherit;margin:0;padding:0;text-align:inherit}button::after{border:none}input,textarea{background:none;color:inherit;font-family:inherit;font-size:inherit}image{display:block}.page{padding:0 48rpx 232rpx;position:relative}.sec{padding:40rpx 0 0}.sec-head{align-items:center;display:flex;justify-content:space-between;margin-bottom:24rpx}.sec-head .bar{background:#ff8a5c;border-radius:4rpx;display:inline-block;height:32rpx;margin-right:16rpx;width:8rpx}.sec-head .label{color:#2d2a26;font-size:30rpx;font-weight:900;letter-spacing:1rpx}.sec-head .more{color:#ff7a45;font-size:24rpx;font-weight:700}.page-head{align-items:center;display:flex;justify-content:space-between;padding-top:28rpx}.page-title{color:#2d2a26;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:40rpx;font-weight:900}.page-sub{color:#a89f92;font-size:22rpx;margin-top:6rpx}.head-icon-btn{align-items:center;background:#fff;border-radius:50%;box-shadow:0 8rpx 24rpx rgba(93,66,42,.08);display:flex;flex-shrink:0;height:72rpx;justify-content:center;overflow:hidden;width:72rpx}.head-icon-btn image{height:40rpx;width:40rpx}.card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06)}.chips{display:flex;flex-wrap:wrap;gap:16rpx;padding:28rpx 0 0}.chip{background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;font-size:22rpx;font-weight:700;padding:16rpx 32rpx}.chip.on{background:#ff8a5c;color:#fff}.tag{align-items:center;border-radius:9999rpx;display:inline-flex;font-size:19rpx;font-weight:800;padding:8rpx 20rpx}.tag.easy{background:#e8f6ee;color:#4caf7d}.tag.mid{background:#fff3e0;color:#ff9f43}.tag.hard{background:#ffe9e9;color:#ff5d5d}.tag.kp{background:#f5f1ea;color:#8a8072}.tag.ai-gen{background:#fff0e8;color:#ff7a45}.skeleton{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:32rpx 36rpx}.skeleton .sk-line{-webkit-animation:sk-shimmer 1.4s infinite;animation:sk-shimmer 1.4s infinite;background:linear-gradient(90deg,#f5f1ea 25%,#fbf8f3 50%,#f5f1ea 75%);background-size:200% 100%;border-radius:12rpx;height:26rpx}.skeleton .sk-line.short{width:52%}.skeleton .sk-row{display:flex;gap:16rpx;margin-top:24rpx}.skeleton .sk-tag{-webkit-animation:sk-shimmer 1.4s infinite;animation:sk-shimmer 1.4s infinite;background:#f5f1ea;border-radius:9999rpx;height:32rpx;width:92rpx}@-webkit-keyframes sk-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}@keyframes sk-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}.state-box{color:#a89f92;font-size:24rpx;line-height:1.9;padding:88rpx 48rpx;text-align:center}.state-box .retry-btn{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;display:inline-block;font-size:24rpx;font-weight:700;margin-top:28rpx;padding:18rpx 44rpx}