page{background:#fbf8f3;color:#2d2a26;font-size:28rpx;line-height:1.5}.page{padding:24rpx 24rpx 48rpx}.card{background:#fff;border-radius:20rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:28rpx 24rpx}.sec-head{align-items:center;display:flex;justify-content:space-between;margin:30rpx 8rpx 18rpx}.sec-head .label{color:#2d2a26;font-size:30rpx;font-weight:800}.sec-head .more{color:#a89f92;font-size:24rpx}.tag{align-items:center;border-radius:999rpx;display:inline-flex;font-size:22rpx;font-weight:600;margin-right:12rpx;padding:6rpx 18rpx}.tag.easy{background:#e8f6ee;color:#4caf7d}.tag.mid{background:#fff3e0;color:#ff9f43}.tag.hard{background:#ffe9e9;color:#ff5d5d}.tag.kp{background:#fff0e8;color:#ff7a45}.tag.ai-gen{background:#f0ebe3;color:#a89f92}