.ring{align-items:center;border-radius:50%;display:flex;justify-content:center}.ring-inner{align-items:center;background:#fbf8f3;border-radius:50%;display:flex;flex-direction:column;justify-content:center}.skeleton{padding:0 24rpx}.sk-card{background:#fff;border-radius:20rpx;margin-bottom:20rpx;padding:28rpx 24rpx}.sk-line{-webkit-animation:sk-loading 1.4s ease infinite;animation:sk-loading 1.4s ease infinite;background:linear-gradient(90deg,#f3ede6 25%,#fbf8f3 37%,#f3ede6 63%);background-size:400% 100%;border-radius:8rpx;height:30rpx}.sk-row{display:flex;margin-top:20rpx}.sk-tag{-webkit-animation:sk-loading 1.4s ease infinite;animation:sk-loading 1.4s ease infinite;background:linear-gradient(90deg,#f3ede6 25%,#fbf8f3 37%,#f3ede6 63%);background-size:400% 100%;border-radius:999rpx;height:30rpx;margin-right:12rpx;width:88rpx}@-webkit-keyframes sk-loading{0%{background-position:100% 50%}100%{background-position:0 50%}}@keyframes sk-loading{0%{background-position:100% 50%}100%{background-position:0 50%}}.state-box{align-items:center;display:flex;flex-direction:column;justify-content:center;padding:80rpx 40rpx}.state-icon{font-size:64rpx;margin-bottom:20rpx}.state-text{color:#a89f92;font-size:26rpx;line-height:1.6;text-align:center}.retry-btn{background:#ff8a5c;border-radius:999rpx;color:#fff;font-size:28rpx;font-weight:700;margin-top:30rpx;padding:16rpx 56rpx}