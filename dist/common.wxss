.ring{align-items:center;border-radius:50%;display:flex;justify-content:center}.ring-inner{align-items:center;background:transparent;border-radius:50%;display:flex;flex-direction:column;justify-content:center}.skeleton{padding:0}.sk-card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:32rpx 36rpx}.sk-line{-webkit-animation:sk-loading 1.4s ease infinite;animation:sk-loading 1.4s ease infinite;background:linear-gradient(90deg,#f5f1ea 25%,#fbf8f3 50%,#f5f1ea 75%);background-size:200% 100%;border-radius:12rpx;height:26rpx}.sk-row{display:flex;gap:16rpx;margin-top:24rpx}.sk-tag{-webkit-animation:sk-loading 1.4s ease infinite;animation:sk-loading 1.4s ease infinite;background:#f5f1ea;border-radius:9999rpx;height:32rpx;width:92rpx}@-webkit-keyframes sk-loading{0%{background-position:200% 0}100%{background-position:-200% 0}}@keyframes sk-loading{0%{background-position:200% 0}100%{background-position:-200% 0}}.state-box{align-items:center;display:flex;flex-direction:column;justify-content:center;padding:88rpx 48rpx;text-align:center}.state-icon{font-size:68rpx;margin-bottom:20rpx}.state-text{color:#a89f92;font-size:24rpx;line-height:1.9;text-align:center}.retry-btn{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;font-size:24rpx;font-weight:700;margin-top:28rpx;padding:18rpx 44rpx}