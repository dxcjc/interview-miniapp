.jobs{padding-top:0}.job-insight{background:linear-gradient(145deg,#fff9f2,#ffefe3);border-radius:44rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.15);padding:32rpx 36rpx}.job-insight-title{align-items:center;background:#ff8a5c;border-radius:9999rpx;color:#fff;display:inline-flex;font-size:18rpx;font-weight:900;padding:6rpx 20rpx}.job-insight-summary{background:#fbf4e8;border-radius:28rpx;color:#9a7b5c;font-size:21rpx;font-weight:700;line-height:1.7;margin-top:20rpx;padding:20rpx 24rpx}.job-insight-hot{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.job-insight-dir{align-items:center;background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.06);display:flex;gap:8rpx;padding:12rpx 24rpx}.job-insight-dir-name{color:#8a8072;font-size:19rpx;font-weight:800}.job-insight-dir-count{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:26rpx;font-weight:900}.job-insight-dir-trend{font-size:20rpx;margin-left:4rpx}.job-insight-dir-trend.up{color:#4caf7d}.job-insight-dir-trend.down{color:#ff5d5d}.job-insight-dir-trend.flat{color:#a89f92}.job-insight-skills{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.job-skill{border-radius:9999rpx;font-size:19rpx;font-weight:800;padding:8rpx 22rpx}.job-skill.high{background:#ff8a5c;box-shadow:0 4rpx 16rpx rgba(255,138,92,.25);color:#fff}.job-skill.mid{background:#fff0e8;border:1rpx solid #ffb28f;color:#ff7a45}.job-skill.low{background:#fff;border:1rpx solid #f0ebe3;color:#a89f92}.job-dirs{display:flex;flex-wrap:wrap;gap:16rpx;margin:28rpx 0 10rpx}.job-dir-chip{background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;font-size:21rpx;font-weight:800;padding:16rpx 30rpx}.job-dir-chip.on{background:#ff8a5c;box-shadow:0 8rpx 28rpx rgba(255,138,92,.4);color:#fff}.job-count{color:#a89f92;font-size:21rpx;font-weight:800;padding:20rpx 0 12rpx}.job-card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:32rpx 36rpx}.job-top{align-items:flex-start;display:flex;gap:20rpx;justify-content:space-between}.job-title{color:#2d2a26;flex:1;font-size:28rpx;font-weight:900;line-height:1.4}.job-company{color:#a89f92;font-size:22rpx;font-weight:800;margin-top:8rpx}.job-meta{align-items:center;display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.job-meta .tag{margin-right:0}.job-city{color:#b4aa9c;font-size:20rpx;font-weight:700;margin-right:8rpx}.job-foot{border-top:1rpx solid #f6f2ec;display:flex;justify-content:space-between;margin-top:20rpx;padding-top:20rpx}.job-posted,.job-source{color:#b4aa9c;font-size:18rpx;font-weight:700}.job-more{color:#ff7a45;font-size:26rpx;font-weight:700;padding:40rpx 0 8rpx;text-align:center}.job-insight-error{color:#a89f92;font-size:22rpx;padding:16rpx 0;text-align:center}