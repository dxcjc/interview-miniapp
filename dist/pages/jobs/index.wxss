.jobs{padding-top:8rpx}.job-insight{background:linear-gradient(140deg,#fff8f4,#fff)}.job-insight-title{font-size:30rpx;font-weight:900}.job-insight-summary{color:#6b645c;font-size:25rpx;line-height:1.7;margin-top:12rpx}.job-insight-hot{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.job-insight-dir{align-items:center;background:#fff0e8;border-radius:999rpx;color:#4a453e;display:flex;font-size:24rpx;font-weight:700;padding:10rpx 20rpx}.job-insight-dir-count{color:#ff7a45;font-weight:900;margin-left:10rpx}.job-insight-dir-trend{font-size:20rpx;margin-left:6rpx}.job-insight-dir-trend.up{color:#4caf7d}.job-insight-dir-trend.down{color:#ff5d5d}.job-insight-dir-trend.flat{color:#a89f92}.job-insight-skills{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.job-skill{border-radius:999rpx;font-size:22rpx;font-weight:700;padding:8rpx 18rpx}.job-skill.high{background:#e8f6ee;color:#4caf7d}.job-skill.mid{background:#fff3e0;color:#ff9f43}.job-skill.low{background:#f3ede6;color:#a89f92}.job-dirs{display:flex;flex-wrap:wrap;gap:12rpx;margin:20rpx 0 6rpx}.job-dir-chip{background:#fff;border-radius:999rpx;box-shadow:0 4rpx 12rpx rgba(93,66,42,.05);color:#a89f92;font-size:24rpx;font-weight:700;padding:12rpx 28rpx}.job-dir-chip.on{background:#ff8a5c;box-shadow:0 8rpx 24rpx rgba(255,138,92,.32);color:#fff}.job-count{color:#a89f92;font-size:23rpx;padding:16rpx 8rpx 6rpx}.job-card{margin-bottom:16rpx}.job-top{align-items:flex-start;display:flex;justify-content:space-between}.job-title{flex:1;font-size:30rpx;font-weight:900;line-height:1.4;margin-right:14rpx}.job-company{color:#6b645c;font-size:26rpx;margin-top:8rpx}.job-meta{align-items:center;display:flex;flex-wrap:wrap;gap:6rpx;margin-top:14rpx}.job-city{color:#a89f92;font-size:23rpx;margin-right:8rpx}.job-foot{border-top:1rpx solid #f6f2ec;display:flex;justify-content:space-between;margin-top:16rpx;padding-top:14rpx}.job-posted,.job-source{color:#b4aa9c;font-size:21rpx}.job-more{color:#ff7a45;font-size:26rpx;font-weight:700;padding:24rpx 0;text-align:center}.job-insight-error{color:#a89f92;font-size:22rpx;padding:12rpx 0;text-align:center}