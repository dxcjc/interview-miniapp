.mine{padding-top:8rpx}.mi-user{align-items:center;background:linear-gradient(140deg,#fff0e8,#ffe3d3);border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(255,138,92,.22);display:flex;padding:36rpx 32rpx}.mi-avatar{align-items:center;background:#fff;border-radius:50%;box-shadow:0 4rpx 12rpx rgba(93,66,42,.1);display:flex;font-size:56rpx;height:108rpx;justify-content:center;width:108rpx}.mi-info{margin-left:24rpx}.mi-name{font-size:40rpx;font-weight:900}.mi-target{color:#8a7f72;font-size:24rpx;margin-top:8rpx}.mi-stats{background:#fff;border-radius:20rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.06);display:flex;margin-top:20rpx;padding:26rpx 0}.mi-stat{flex:1;text-align:center}.mi-v{font-family:Georgia,serif;font-size:40rpx;font-weight:900}.mi-k{color:#a89f92;font-size:22rpx;margin-top:4rpx}.mi-entries{margin-top:24rpx}.mi-entry{align-items:center;display:flex;margin-bottom:16rpx;padding:26rpx 24rpx}.mi-entry-icon{align-items:center;background:#fff0e8;border-radius:16rpx;display:flex;font-size:32rpx;height:68rpx;justify-content:center;width:68rpx}.mi-entry-body{flex:1;margin-left:20rpx}.mi-entry-name{font-size:29rpx;font-weight:800}.mi-entry-sub{color:#a89f92;font-size:22rpx;margin-top:4rpx}.mi-entry-arrow{color:#d8cfc2;font-size:34rpx}.mi-foot{color:#c8beb0;font-size:22rpx;padding:30rpx 0 10rpx;text-align:center}