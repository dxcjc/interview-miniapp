.mine{padding-top:0}.mi-user{align-items:center;background:linear-gradient(145deg,#fff6ef,#ffefe3);border-radius:52rpx;box-shadow:0 24rpx 72rpx rgba(255,138,92,.18);display:flex;gap:32rpx;overflow:hidden;padding:40rpx;position:relative}.mi-user::after,.mi-user::before{background:rgba(255,138,92,.12);border-radius:50%;content:"";position:absolute}.mi-user::before{height:180rpx;right:-50rpx;top:-50rpx;width:180rpx}.mi-user::after{background:rgba(255,138,92,.08);bottom:-36rpx;height:100rpx;right:60rpx;width:100rpx}.mi-avatar{align-items:center;background:#fff;border-radius:50%;box-shadow:0 16rpx 48rpx rgba(255,138,92,.35);display:flex;flex-shrink:0;font-size:56rpx;height:120rpx;justify-content:center;position:relative;width:120rpx;z-index:1}.mi-info{flex:1;min-width:0;position:relative;z-index:1}.mi-name{color:#2d2a26;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:38rpx;font-weight:900}.mi-target{color:#a89f92;font-size:22rpx;font-weight:600;margin-top:10rpx}.mi-stats{background:#fff;border-radius:44rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;margin-top:28rpx;overflow:hidden;padding:32rpx 0}.mi-stat{flex:1;position:relative;text-align:center}.mi-stat + .mi-stat::before{background:#f0ebe3;bottom:28%;content:"";left:0;position:absolute;top:28%;width:1rpx}.mi-v{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:48rpx;font-weight:900;line-height:1}.mi-k{color:#6b635a;font-size:21rpx;font-weight:700;margin-top:10rpx}.mi-entries{margin-top:28rpx}.mi-entry{align-items:center;background:#fff;border-radius:36rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;gap:24rpx;margin-bottom:16rpx;padding:22rpx 32rpx}.mi-entry-icon{align-items:center;background:#fff0e8;border-radius:26rpx;display:flex;flex-shrink:0;font-size:36rpx;height:84rpx;justify-content:center;width:84rpx}.mi-entry:nth-child(2n+1) .mi-entry-icon{background:#fff0e8}.mi-entry:nth-child(2n) .mi-entry-icon{background:#e8f6ee}.mi-entry-body{flex:1;min-width:0}.mi-entry-name{color:#2d2a26;font-size:26rpx;font-weight:700}.mi-entry-sub{color:#b4aa9c;font-size:20rpx;margin-top:4rpx}.mi-entry-arrow{color:#d5cdc2;flex-shrink:0;font-size:32rpx;font-weight:700}.mi-foot{color:#c8beb0;font-size:22rpx;padding:40rpx 0 10rpx;text-align:center}