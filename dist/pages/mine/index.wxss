.me-hero{align-items:center;background:linear-gradient(145deg,#fff6ef,#ffefe3);border-radius:52rpx;box-shadow:0 24rpx 72rpx rgba(255,138,92,.18);display:flex;gap:32rpx;margin-top:28rpx;overflow:hidden;padding:40rpx;position:relative}.me-hero::after,.me-hero::before{background:rgba(255,138,92,.12);border-radius:50%;content:"";position:absolute}.me-hero::before{height:180rpx;right:-50rpx;top:-50rpx;width:180rpx}.me-hero::after{background:rgba(255,138,92,.08);bottom:-36rpx;height:100rpx;right:60rpx;width:100rpx}.me-avatar{border-radius:50%;box-shadow:0 16rpx 48rpx rgba(255,138,92,.35);flex-shrink:0;height:120rpx;overflow:hidden;position:relative;width:120rpx;z-index:1}.me-avatar image{height:100%;padding:8rpx;width:100%}.me-info{flex:1;min-width:0;position:relative;z-index:1}.me-name{color:#2d2a26;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:38rpx;font-weight:900}.me-title{color:#a89f92;font-size:22rpx;font-weight:600;margin-top:10rpx}.me-title .dotsep{color:#ff8a5c;margin:0 6rpx}.me-badge{align-items:center;background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(255,138,92,.15);color:#ff7a45;display:inline-flex;font-size:19rpx;font-weight:800;margin-top:16rpx;max-width:100%;overflow:hidden;padding:8rpx 24rpx;text-overflow:ellipsis;white-space:nowrap}.me-badge image{height:26rpx;margin-right:6rpx;width:26rpx}.me-hero .go{align-items:center;background:#fff;border-radius:50%;box-shadow:0 4rpx 16rpx rgba(93,66,42,.1);color:#c9b8a6;display:flex;flex-shrink:0;font-size:30rpx;height:60rpx;justify-content:center;position:relative;width:60rpx;z-index:1}.me-stats{background:#fff;border-radius:44rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;margin-top:28rpx;overflow:hidden}.me-stat{flex:1;padding:32rpx 16rpx;position:relative;text-align:center}.me-stat + .me-stat::before{background:#f0ebe3;bottom:28%;content:"";left:0;position:absolute;top:28%;width:2rpx}.me-stat .v{color:#ff7a45;font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:48rpx;font-weight:900;line-height:1}.me-stat .v .small{color:#b4aa9c;font-size:22rpx;font-weight:700;margin-left:2rpx}.me-stat .v.loading{-webkit-animation:stat-pulse 1.2s infinite;animation:stat-pulse 1.2s infinite;color:#b4aa9c}@-webkit-keyframes stat-pulse{50%{opacity:.4}}@keyframes stat-pulse{50%{opacity:.4}}.me-stat .k{color:#6b635a;font-size:21rpx;font-weight:700;margin-top:8rpx}.menu{padding-top:28rpx}.menu-item{align-items:center;background:#fff;border-radius:36rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;gap:28rpx;margin-bottom:16rpx;padding:22rpx 32rpx}.menu-item .ico{align-items:center;border-radius:26rpx;display:flex;flex-shrink:0;height:84rpx;justify-content:center;overflow:hidden;width:84rpx}.menu-item .ico image{height:100%;padding:12rpx;width:100%}.mi-orange{background:#fff0e8}.mi-green{background:#e8f6ee}.mi-lav{background:#f0ecff}.mi-blue{background:#e8f1ff}.mi-yellow{background:#fff3e0}.menu-item .t{flex:1;font-size:26rpx;font-weight:700}.menu-item .arrow{color:#d5cdc2;font-size:32rpx;font-weight:700}