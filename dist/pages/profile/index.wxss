.pf-cloud{display:flex;flex-wrap:wrap;gap:14rpx}.pf-skill{background:#fff;border:2rpx solid #f0ebe3;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;font-size:20rpx;font-weight:800;padding:10rpx 26rpx}.pf-skill.hot{background:#fff0e8;border-color:#ffb28f;color:#ff7a45}.pf-card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:32rpx 36rpx}.pf-name{color:#2d2a26;font-size:28rpx;font-weight:900;line-height:1.5}.pf-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.pf-tags .tag{margin-right:0}.pf-desc{color:#8a8072;font-size:22rpx;font-weight:500;line-height:1.8;margin-top:20rpx}