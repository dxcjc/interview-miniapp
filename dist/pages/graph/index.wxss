.graph{padding-top:0}.graph-center{background:linear-gradient(145deg,#fff9f2,#ffefe3);border-radius:44rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.15);overflow:hidden;padding:36rpx 40rpx;position:relative}.graph-center-name{color:#2d2a26;font-size:28rpx;font-weight:900}.graph-center-mastery{color:#b08d74;font-size:21rpx;font-weight:700;margin-top:8rpx}.graph-center-bar{background:#ffe3d3;border-radius:10rpx;height:12rpx;margin-top:20rpx;overflow:hidden}.graph-center-fill{background:linear-gradient(90deg,#ffb28f,#ff8a5c);border-radius:10rpx;height:100%}.graph-nodes{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);padding:8rpx 32rpx}.graph-node{border-bottom:1rpx dashed #f0ebe3;padding:36rpx 8rpx}.graph-node:last-child{border-bottom:none}.graph-node-top{align-items:center;display:flex;justify-content:space-between}.graph-node-name{color:#2d2a26;font-size:28rpx;font-weight:800}.graph-node-pct{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:26rpx;font-weight:900}.graph-node-bar{background:#f5f1ea;border-radius:12rpx;height:12rpx;margin-top:16rpx;overflow:hidden}.graph-node-fill{border-radius:12rpx;height:100%}.graph-node-fill.low{background:linear-gradient(90deg,#ff8a7a,#ff5d5d)}.graph-node-fill.mid{background:linear-gradient(90deg,#ffb28f,#ff9f43)}.graph-node-fill.high{background:linear-gradient(90deg,#7bc69b,#4caf7d)}.graph-node-level{display:inline-block;font-size:22rpx;font-weight:700;margin-top:16rpx}.graph-node-level.low{color:#ff9f43}.graph-node-level.mid{color:#ff7a45}.graph-node-level.high{color:#4caf7d}.graph-empty{color:#a89f92;font-size:22rpx;padding:40rpx 0;text-align:center}