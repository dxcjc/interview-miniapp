.graph{padding-top:8rpx}.graph-center{background:linear-gradient(140deg,#fff8f4,#fff);padding:40rpx 24rpx;text-align:center}.graph-center-name{font-size:38rpx;font-weight:900}.graph-center-mastery{color:#a89f92;font-size:24rpx;margin-top:10rpx}.graph-center-bar{background:#f3ede6;border-radius:999rpx;height:16rpx;margin-top:16rpx;overflow:hidden}.graph-center-fill{border-radius:999rpx;height:100%}.graph-node{border-bottom:1rpx solid #f6f2ec;padding:22rpx 4rpx}.graph-node:last-child{border-bottom:none}.graph-node-top{align-items:center;display:flex;justify-content:space-between}.graph-node-name{font-size:28rpx;font-weight:800}.graph-node-pct{font-size:26rpx;font-weight:900}.graph-node-bar{background:#f3ede6;border-radius:999rpx;height:14rpx;margin-top:12rpx;overflow:hidden}.graph-node-fill{border-radius:999rpx;height:100%}.graph-node-fill.low{background:#ff9f43}.graph-node-fill.mid{background:#ff8a5c}.graph-node-fill.high{background:#4caf7d}.graph-node-level{display:inline-block;font-size:22rpx;font-weight:700;margin-top:10rpx}.graph-node-level.low{color:#ff9f43}.graph-node-level.mid{color:#ff7a45}.graph-node-level.high{color:#4caf7d}.graph-empty{color:#a89f92;font-size:26rpx;padding:40rpx 0;text-align:center}