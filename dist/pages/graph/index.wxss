.weak-card{align-items:center;background:linear-gradient(145deg,#fff9f2,#ffefe3);border-radius:44rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.15);display:flex;gap:28rpx;margin-top:32rpx;overflow:hidden;padding:36rpx 40rpx;position:relative}.weak-card .ico{align-items:center;background:#ff8a5c;border-radius:28rpx;display:flex;flex-shrink:0;height:88rpx;justify-content:center;overflow:hidden;width:88rpx}.weak-card .ico image{height:100%;padding:10rpx;width:100%}.weak-card .body{flex:1;min-width:0}.weak-card .t{font-size:24rpx;font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.weak-card .t .lv{color:#ff7a45;font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:52rpx;font-weight:900;margin-left:8rpx}.weak-card .t .lvt{color:#b08d74;font-size:18rpx;font-weight:700;margin-left:4rpx}.weak-card .bar{background:#ffe3d3;border-radius:10rpx;height:12rpx;margin-top:16rpx;overflow:hidden}.weak-card .bar > view{background:linear-gradient(90deg,#ffb28f,#ff8a5c);border-radius:10rpx;display:block;height:100%}.weak-card .s{color:#b08d74;font-size:20rpx;font-weight:600;margin-top:12rpx}.weak-card .deco{bottom:-28rpx;height:140rpx;opacity:.15;position:absolute;right:-24rpx;-webkit-transform:rotate(-10deg);transform:rotate(-10deg);width:140rpx}.weak-card .deco image{height:100%;width:100%}.graph-card{background:#fff;border-radius:48rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-top:32rpx;padding:24rpx}.graph-card .chart{align-content:center;align-items:center;display:flex;flex-wrap:wrap;gap:20rpx;justify-content:center;min-height:680rpx;width:100%}.graph-card .graph-node{align-items:center;border-radius:9999rpx;display:inline-flex;font-size:22rpx;font-weight:800;gap:10rpx;line-height:1.2;padding:14rpx 26rpx}.graph-card .graph-node .gn-name{max-width:240rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.graph-card .graph-node .gn-pct{font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:24rpx;font-weight:900}.graph-legend{color:#8a8072;display:flex;font-size:20rpx;font-weight:600;gap:36rpx;justify-content:center;padding-bottom:8rpx;padding-top:28rpx}.graph-legend .lg{align-items:center;display:flex;gap:10rpx}.graph-legend .sw{border-radius:6rpx;display:inline-block;height:20rpx;width:20rpx}.graph-mask{align-items:center;background:rgba(45,42,38,.45);bottom:0;display:flex;justify-content:center;left:0;padding:48rpx;position:fixed;right:0;top:0;z-index:90}.graph-dialog{background:#fff;border-radius:44rpx;box-shadow:0 24rpx 80rpx rgba(93,66,42,.18);max-width:560rpx;padding:44rpx 40rpx 36rpx;text-align:center;width:100%}.graph-dialog .gd-name{font-size:30rpx;font-weight:900}.graph-dialog .gd-mastery{color:#ff7a45;font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:80rpx;font-weight:900;line-height:1.1;margin-top:12rpx}.graph-dialog .gd-bar{background:#f5f1ea;border-radius:12rpx;height:16rpx;margin-top:28rpx;overflow:hidden}.graph-dialog .gd-bar > view{border-radius:12rpx;display:block;height:100%}.graph-dialog .gd-hint{color:#a89f92;font-size:19rpx;line-height:1.6;margin-top:20rpx}.graph-dialog .gd-actions{margin-top:32rpx}.graph-dialog .gd-actions .primary{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;display:block;font-size:24rpx;font-weight:800;padding:20rpx 0;width:100%}.weak-sk{padding:44rpx}.graph-sk{padding:28rpx}