.skeleton{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:32rpx 36rpx}.skeleton .sk-line{-webkit-animation:sk-shimmer 1.4s infinite;animation:sk-shimmer 1.4s infinite;background:linear-gradient(90deg,#f5f1ea 25%,#fbf8f3 50%,#f5f1ea 75%);background-size:200% 100%;border-radius:12rpx;height:26rpx}.skeleton .sk-line.short{width:52%}.skeleton .sk-row{display:flex;gap:16rpx;margin-top:24rpx}.skeleton .sk-tag{-webkit-animation:sk-shimmer 1.4s infinite;animation:sk-shimmer 1.4s infinite;background:#f5f1ea;border-radius:9999rpx;height:32rpx;width:92rpx}@-webkit-keyframes sk-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}@keyframes sk-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}.state-box{color:#a89f92;font-size:24rpx;line-height:1.9;padding:88rpx 48rpx;text-align:center}.state-box .state-icon{height:68rpx;margin:0 auto 20rpx;width:68rpx}.state-box .state-icon image{height:100%;width:100%}.state-box .retry-btn{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;display:inline-block;font-size:24rpx;font-weight:700;margin-top:28rpx;padding:18rpx 44rpx}.wb-list{padding-top:32rpx}.wb-card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:30rpx 32rpx}.wb-top{align-items:center;display:flex;gap:16rpx}.wb-no{color:#b4aa9c;font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:20rpx;font-weight:900;letter-spacing:2rpx}.wb-dir{background:#fff0e8;color:#ff7a45}.wb-title{color:#2d2a26;display:-webkit-box;font-size:26rpx;font-weight:800;-webkit-line-clamp:2;line-height:1.55;margin-top:16rpx;overflow:hidden;-webkit-box-orient:vertical}.wb-meta{align-items:center;display:flex;flex-wrap:wrap;gap:16rpx;margin-top:18rpx}.wb-wrong{background:#fff0e8;border-radius:9999rpx;color:#ff7a45;font-size:20rpx;font-weight:900;padding:6rpx 20rpx}.wb-time{color:#b4aa9c;font-size:20rpx;font-weight:600}.wb-foot{align-items:center;border-top:2rpx solid #f6f2ec;display:flex;justify-content:space-between;margin-top:20rpx;padding-top:20rpx}.wb-retest{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;font-size:22rpx;font-weight:800;padding:14rpx 36rpx}.wb-retest.disabled{opacity:.6}.wb-mask{align-items:center;background:rgba(45,42,38,.45);bottom:0;display:flex;justify-content:center;left:0;padding:48rpx;position:absolute;right:0;top:0;z-index:90}.wb-dialog{background:#fff;border-radius:44rpx;box-shadow:0 24rpx 80rpx rgba(93,66,42,.18);max-width:580rpx;padding:44rpx 40rpx 36rpx;width:100%}.wb-d-head{color:#ff7a45;font-size:26rpx;font-weight:900;letter-spacing:2rpx}.wb-d-question{color:#2d2a26;font-size:28rpx;font-weight:800;line-height:1.7;margin-top:20rpx}.wb-d-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.wb-d-actions{display:flex;gap:20rpx;margin-top:36rpx}.wb-d-actions .ghost,.wb-d-actions .primary{border-radius:9999rpx;flex:1;font-size:24rpx;font-weight:800;padding:22rpx 0;text-align:center}.wb-d-actions .ghost{background:#f5f1ea;color:#8a8072}.wb-d-actions .primary{background:#ff8a5c;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff}.wb-toast{background:rgba(45,42,38,.85);border-radius:9999rpx;bottom:240rpx;color:#fff;font-size:22rpx;font-weight:700;left:50%;padding:20rpx 36rpx;position:absolute;-webkit-transform:translateX(-50%);transform:translateX(-50%);white-space:nowrap;z-index:95}.wb-d-tags .tag,.wb-foot .tag,.wb-top .tag{margin-right:0}