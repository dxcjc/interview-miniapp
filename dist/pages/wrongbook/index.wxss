.wrongbook{padding-top:0}.wb-count{color:#a89f92;font-size:22rpx;padding:8rpx 0 24rpx}.wb-count .b{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:30rpx;font-weight:900}.wb-card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:30rpx 32rpx}.wb-head{align-items:flex-start;display:flex;gap:16rpx;justify-content:space-between}.wb-title{color:#2d2a26;flex:1;font-size:26rpx;font-weight:800;line-height:1.55}.wb-meta{align-items:center;display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.wb-meta .tag{margin-right:0}.wb-foot{align-items:center;border-top:1rpx solid #f6f2ec;display:flex;justify-content:space-between;margin-top:20rpx;padding-top:20rpx}.wb-wrong{background:#fff0e8;border-radius:9999rpx;color:#ff7a45;font-size:20rpx;font-weight:900;padding:8rpx 20rpx}.wb-retest{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;font-size:22rpx;font-weight:800;padding:16rpx 32rpx}.wb-retest.loading{background:#e8e0d6;box-shadow:none}