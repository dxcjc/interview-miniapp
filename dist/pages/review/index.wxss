gin-top:20rpx}.rv-advice-num{align-items:center;background:#ff8a5c;border-radius:50%;color:#fff;display:flex;flex-shrink:0;font-size:22rpx;font-weight:800;height:40rpx;justify-content:center;margin-right:16rpx;width:40rpx}.rv-advice-text{color:#4a453e;flex:1;font-size:26rpx;line-height:1.6}.rv-empty{color:#a89f92;font-size:26rpx;padding:30rpx 0;text-align:center}.rv-back{background:#ff8a5c;border-radius:999rpx;box-shadow:0 12rpx 32rpx rgba(255,122,69,.28);color:#fff;font-size:30rpx;font-weight:800;margin:30rpx 0 20rpx;padding:24rpx 0;text-align:center}