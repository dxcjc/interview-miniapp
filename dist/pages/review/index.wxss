.review{padding-top:0}.rv-score{align-items:center;background:linear-gradient(145deg,#fff9f2,#ffefe3);border-radius:56rpx;box-shadow:0 24rpx 80rpx rgba(255,138,92,.18);display:flex;flex-direction:column;padding:44rpx 48rpx}.rv-score-num{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:64rpx;font-weight:900;line-height:1}.rv-score-label{color:#c9a48c;font-size:18rpx;font-weight:700;margin-top:4rpx}.rv-score-grade{color:#2d2a26;font-size:26rpx;font-weight:900;margin-top:28rpx}.rv-score-expr{border-top:1rpx solid rgba(255,138,92,.2);display:flex;gap:48rpx;justify-content:center;margin-top:28rpx;padding-top:28rpx;width:100%}.rv-expr-item{text-align:center}.rv-expr-k{color:#b08d74;font-size:20rpx}.rv-expr-v{color:#ff7a45;font-size:28rpx;font-weight:800;margin-top:6rpx}.rv-dims{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);padding:36rpx 40rpx}.rv-dim{padding:20rpx 0}.rv-dim + .rv-dim{border-top:1rpx dashed #f0ebe3}.rv-dim-top{align-items:center;display:flex;justify-content:space-between;margin-bottom:14rpx}.rv-dim-name{color:#2d2a26;font-size:26rpx;font-weight:700}.rv-dim-score{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:26rpx;font-weight:900}.rv-dim-bar{background:#f5f1ea;border-radius:10rpx;height:12rpx;overflow:hidden}.rv-dim-fill{background:linear-gradient(90deg,#ffb28f,#ff8a5c);border-radius:10rpx;height:100%}.rv-q{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:28rpx 32rpx}.rv-q-head{align-items:flex-start;display:flex;gap:16rpx}.rv-q-idx{background:#fff0e8;border-radius:16rpx;color:#ff7a45;flex-shrink:0;font-size:20rpx;font-weight:900;padding:6rpx 20rpx}.rv-q-text{color:#2d2a26;flex:1;font-size:25rpx;font-weight:800;line-height:1.5}.rv-q-score{flex-shrink:0;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:30rpx;font-weight:900;margin-left:12rpx}.rv-q-score.low{color:#ff9f43}.rv-q-score.mid{color:#ff7a45}.rv-q-score.high{color:#4caf7d}.rv-q-status{background:#fff0e8;border-radius:9999rpx;color:#ff7a45;display:inline-block;font-size:20rpx;font-weight:800;margin-top:14rpx;padding:8rpx 22rpx}.rv-q-comment{color:#8a8072;font-size:22rpx;line-height:1.7;margin-top:16rpx}.rv-advice{background:linear-gradient(145deg,#fff9f2,#ffefe3);border-radius:40rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.12);padding:36rpx 40rpx}.rv-advice-item{align-items:flex-start;display:flex;gap:16rpx;padding:12rpx 0}.rv-advice-num{align-items:center;background:#ff8a5c;border-radius:50%;color:#fff;display:flex;flex-shrink:0;font-size:20rpx;font-weight:800;height:40rpx;justify-content:center;margin-top:4rpx;width:40rpx}.rv-advice-text{color:#8a8072;flex:1;font-size:23rpx;line-height:1.9}.rv-empty{color:#a89f92;font-size:22rpx;padding:40rpx 0;text-align:center}.rv-back{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;font-size:26rpx;font-weight:800;margin:60rpx 0 40rpx;padding:28rpx 0;text-align:center}