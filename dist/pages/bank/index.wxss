.bank-head{align-items:center;display:flex;justify-content:space-between;padding:28rpx 0 0}.dir-row{display:flex;flex-wrap:nowrap;gap:16rpx;overflow-x:auto;padding:28rpx 0 0;scrollbar-width:none}.dir-row::-webkit-scrollbar{display:none}.dir{background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;flex:0 0 auto;font-size:22rpx;font-weight:700;padding:18rpx 36rpx}.dir.on{background:#ff8a5c;box-shadow:0 8rpx 28rpx rgba(255,138,92,.4);color:#fff}.search{align-items:center;background:#fff;border-radius:9999rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;gap:20rpx;margin-top:28rpx;padding:26rpx 36rpx}.search input{background:none;border:none;color:#2d2a26;flex:1;font-family:inherit;font-size:26rpx;outline:none}.search .ico{align-items:center;display:flex;height:32rpx;justify-content:center;width:32rpx}.search .ico image{height:100%;opacity:.45;width:100%}.bank-banner{background:linear-gradient(135deg,#ff9a6c,#ff7a45);border-radius:44rpx;box-shadow:0 24rpx 64rpx rgba(255,122,69,.28);margin-top:32rpx;overflow:hidden;padding:40rpx;position:relative}.bank-banner .bt{color:#fff;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:34rpx;font-weight:900}.bank-banner .bs{color:hsla(0,0%,100%,.85);font-size:21rpx;font-weight:500;margin-top:8rpx}.bank-banner .feat{display:flex;gap:24rpx;margin-top:28rpx}.bank-banner .feat text{background:hsla(0,0%,100%,.18);border-radius:9999rpx;color:#fff;font-size:19rpx;font-weight:700;padding:10rpx 22rpx}.bank-banner .illus{height:220rpx;opacity:.2;position:absolute;right:-36rpx;top:-36rpx;-webkit-transform:rotate(12deg);transform:rotate(12deg);width:220rpx}.bank-banner .illus image{height:100%;width:100%}.q-card{margin-bottom:20rpx;padding:32rpx 36rpx}.q-card .qrow{align-items:flex-start;display:flex;gap:20rpx;justify-content:space-between}.q-card .q{flex:1;font-size:27rpx;font-weight:700;line-height:1.6}.q-card .q .proj-badge{background:#fff0e8;border:2rpx solid #ffb28f;border-radius:9999rpx;color:#ff7a45;display:inline-block;font-size:17rpx;font-weight:900;margin-right:12rpx;padding:4rpx 16rpx;vertical-align:4rpx}.q-card .meta{align-items:center;display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.q-card .foot{align-items:center;border-top:2rpx solid #f6f2ec;display:flex;justify-content:space-between;margin-top:20rpx;padding-top:20rpx}.q-card .foot .hot{color:#b4aa9c;font-size:20rpx;font-weight:600}.q-card .foot .chev{color:#d5cdc2;font-size:28rpx;font-weight:700}.q-card.hl{background:linear-gradient(180deg,#fffdfa,#fff6ef);border:3rpx solid #ffb28f}