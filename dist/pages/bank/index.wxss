.bank{padding:28rpx 48rpx 96rpx}.bank-head{align-items:center;display:flex;justify-content:space-between;padding:8rpx 0 0}.dir-row{display:flex;flex-wrap:nowrap;gap:16rpx;margin:28rpx 0 20rpx;overflow-x:auto}.dir{background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;flex:0 0 auto;font-size:22rpx;font-weight:700;padding:18rpx 36rpx;text-align:center}.dir.on{background:#ff8a5c;box-shadow:0 8rpx 28rpx rgba(255,138,92,.4);color:#fff}.search{align-items:center;background:#fff;border-radius:9999rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;gap:20rpx;padding:26rpx 36rpx}.search .ico{font-size:28rpx;opacity:.45}.search-input{color:#2d2a26;flex:1;font-size:26rpx}.chips{margin:24rpx 0 28rpx}.q-list{padding-top:4rpx}.q-card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:32rpx 36rpx}.qrow{align-items:flex-start;display:flex;gap:20rpx;justify-content:space-between}.qrow .q{color:#2d2a26;flex:1;font-size:27rpx;font-weight:700;line-height:1.6}.proj-badge{background:#fff0e8;border:1rpx solid #ffb28f;border-radius:9999rpx;color:#ff7a45;display:inline-flex;font-size:17rpx;font-weight:900;margin-right:12rpx;padding:4rpx 16rpx;vertical-align:4rpx}.meta{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.meta .tag{margin-right:0}.foot{align-items:center;border-top:1rpx solid #f6f2ec;display:flex;justify-content:space-between;margin-top:20rpx;padding-top:20rpx}.foot .hot{color:#b4aa9c;font-size:20rpx;font-weight:600}.foot .chev{color:#d5cdc2;font-size:28rpx;font-weight:700}