.bank-head{align-items:center;display:flex;justify-content:space-between;padding:28rpx 0 0}.dir-row{display:flex;flex-wrap:nowrap;gap:16rpx;overflow-x:auto;padding:28rpx 0 0;scrollbar-width:none}.dir-row::-webkit-scrollbar{display:none}.dir{background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;flex:0 0 auto;font-size:22rpx;font-weight:700;padding:18rpx 36rpx}.dir.on{background:#ff8a5c;box-shadow:0 8rpx 28rpx rgba(255,138,92,.4);color:#fff}.search{align-items:center;background:#fff;border-radius:9999rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;gap:20rpx;margin-top:28rpx;padding:26rpx 36rpx}.search input{background:none;border:none;color:#2d2a26;flex:1;font-family:inherit;font-size:26rpx;outline:none}.search .ico{align-items:center;display:flex;height:32rpx;justify-content:center;width:32rpx}.search .ico image{height:100%;opacity:.45;width:100%}.bank-banner{background:linear-gradient(135deg,#ff9a6c,#ff7a45);border-radius:44rpx;box-shadow:0 24rpx 64rpx rgba(255,122,69,.28);margin-top:32rpx;overflow:hidden;padding:40rpx;position:relative}.bank-banner .bt{color:#fff;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:34rpx;font-weight:900}.bank-banner .bs{color:hsla(0,0%,100%,.85);font-size:21rpx;font-weight:500;margin-top:8rpx}.bank-banner .feat{display:flex;gap:24rpx;margin-top:28rpx}.bank-banner .feat text{background:hsla(0,0%,100%,.18);border-radius:9999rpx;color:#fff;font-size:19rpx;font-weight:700;padding:10rpx 22rpx}.bank-banner .illus{height:220rpx;opacity:.2;position:absolute;right:-36rpx;top:-36rpx;-webkit-transform:rotate(12deg);transform:rotate(12deg);width:220rpx}.bank-banner .illus image{height:100%;width:100%}.q-card{margin-bottom:20rpx;padding:32rpx 36rpx}.q-card .qrow{align-items:flex-start;display:flex;gap:20rpx;justify-content:space-between}.q-card .q{flex:1;font-size:27rpx;font-weight:700;line-height:1.6}.q-card .q .proj-badge{background:#fff0e8;border:2rpx solid #ffb28f;border-radius:9999rpx;color:#ff7a45;display:inline-block;font-size:17rpx;font-weight:900;margin-right:12rpx;padding:4rpx 16rpx;vertical-align:4rpx}.q-card .meta{align-items:center;display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.q-card .foot{align-items:center;border-top:2rpx solid #f6f2ec;display:flex;justify-content:space-between;margin-top:20rpx;padding-top:20rpx}.q-card .foot .tag.src{background:#e8f6ee;color:#4caf7d;margin-right:0}.bank-empty-actions{display:flex;gap:24rpx;justify-content:center;margin-top:32rpx}.bank-empty-ghost{background:#fff0e8;border-radius:9999rpx;color:#ff7a45;font-size:24rpx;font-weight:700;padding:18rpx 44rpx}.bank-mask{align-items:center;background:rgba(45,42,38,.45);bottom:0;display:flex;justify-content:center;left:0;padding:48rpx;position:absolute;right:0;top:0;z-index:90}.bank-dialog{background:#fff;border-radius:44rpx;box-shadow:0 24rpx 80rpx rgba(93,66,42,.18);max-height:80vh;max-width:600rpx;overflow-y:auto;padding:44rpx 40rpx 36rpx;width:100%}.bank-d-head{color:#ff7a45;font-size:30rpx;font-weight:900;letter-spacing:2rpx;margin-bottom:32rpx}.bank-d-row{margin-bottom:28rpx}.bank-d-label{color:#a89f92;display:block;font-size:22rpx;font-weight:800;margin-bottom:12rpx}.bank-d-area{background:#faf7f2;border-radius:24rpx;box-sizing:border-box;color:#2d2a26;font-size:26rpx;line-height:1.6;min-height:140rpx;padding:22rpx 26rpx;width:100%}.bank-d-static{align-items:center;background:#faf7f2;border-radius:24rpx;color:#2d2a26;display:flex;font-size:26rpx;font-weight:700;justify-content:space-between;padding:22rpx 26rpx}.bank-d-static .bank-d-chev{color:#b4aa9c;font-weight:700}.bank-d-input{background:#faf7f2;border-radius:24rpx;box-sizing:border-box;color:#2d2a26;font-size:26rpx;padding:22rpx 26rpx;width:100%}.bank-d-actions{display:flex;gap:20rpx;margin-top:36rpx}.bank-d-actions .ghost,.bank-d-actions .primary{border-radius:9999rpx;flex:1;font-size:24rpx;font-weight:800;padding:22rpx 0;text-align:center}.bank-d-actions .ghost{background:#f5f1ea;color:#8a8072}.bank-d-actions .primary{background:#ff8a5c;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff}.bank-d-actions .primary.disabled{opacity:.6}.q-card .foot .chev{color:#d5cdc2;font-size:28rpx;font-weight:700}.q-card.hl{background:linear-gradient(180deg,#fffdfa,#fff6ef);border:3rpx solid #ffb28f}.detail-head{align-items:center;display:flex;justify-content:space-between;margin-bottom:24rpx}.detail-head .tag{font-size:20rpx;padding:10rpx 28rpx}.detail-close{background:#f5f1ea;border-radius:50%;color:#8a8072;flex-shrink:0;font-size:34rpx;font-weight:700;height:56rpx;line-height:56rpx;text-align:center;width:56rpx}.detail-title{color:#2d2a26;font-size:30rpx;font-weight:800;line-height:1.6}.detail-chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.detail-block{margin-top:28rpx}.detail-label{align-items:center;color:#a89f92;display:flex;font-size:21rpx;font-weight:800;margin-bottom:12rpx}.detail-label::before{background:#ff8a5c;border-radius:50%;content:"";height:8rpx;margin-right:10rpx;width:8rpx}.detail-body{background:#faf7f2;border-radius:24rpx;color:#4a453e;font-size:25rpx;line-height:1.7;padding:22rpx 26rpx}.detail-followup{align-items:flex-start;background:#faf7f2;border-radius:24rpx;color:#4a453e;display:flex;font-size:25rpx;gap:16rpx;line-height:1.6;margin-bottom:14rpx;padding:20rpx 26rpx}.detail-followup:last-child{margin-bottom:0}.detail-no{background:#ff8a5c;border-radius:50%;color:#fff;flex-shrink:0;font-size:19rpx;font-weight:800;height:36rpx;line-height:36rpx;margin-top:4rpx;text-align:center;width:36rpx}.detail-ft{flex:1}.detail-foot{align-items:center;border-top:2rpx solid #f6f2ec;display:flex;gap:12rpx;margin-top:28rpx;padding-top:24rpx}.detail-actions{margin-top:32rpx}.detail-actions .primary{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;font-size:24rpx;font-weight:800;padding:22rpx 0;text-align:center;width:100%}