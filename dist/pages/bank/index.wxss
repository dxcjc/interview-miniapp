.bank{padding:24rpx 24rpx 48rpx}.bank-head{align-items:center;display:flex;justify-content:space-between;padding:8rpx 8rpx 0}.page-title{font-size:40rpx;font-weight:900}.page-sub{color:#a89f92;font-size:24rpx;margin-top:6rpx}.dir-row{display:flex;gap:16rpx;margin:28rpx 0 20rpx}.dir{background:#fff;border-radius:16rpx;box-shadow:0 4rpx 12rpx rgba(93,66,42,.05);color:#a89f92;flex:1;font-size:26rpx;font-weight:700;padding:18rpx 0;text-align:center}.dir.on{background:#ff8a5c;box-shadow:0 8rpx 24rpx rgba(255,138,92,.32);color:#fff}.search{align-items:center;background:#fff;border-radius:999rpx;box-shadow:0 4rpx 12rpx rgba(93,66,42,.05);display:flex;padding:18rpx 24rpx}.search .ico{font-size:28rpx;margin-right:12rpx}.search-input{flex:1;font-size:26rpx}.chips{display:flex;flex-wrap:wrap;gap:14rpx;margin:20rpx 0}.chip{background:#fff;border-radius:999rpx;box-shadow:0 4rpx 12rpx rgba(93,66,42,.05);color:#a89f92;font-size:24rpx;font-weight:600;padding:10rpx 26rpx}.chip.on{background:#fff0e8;color:#ff7a45}.q-list{margin-top:8rpx}.q-card{margin-bottom:18rpx}.qrow{align-items:flex-start;display:flex;justify-content:space-between}.qrow .q{flex:1;font-size:29rpx;font-weight:700;line-height:1.5;margin-right:16rpx}.proj-badge{background:#fff0e8;border-radius:8rpx;color:#ff7a45;display:inline-flex;font-size:20rpx;font-weight:800;margin-right:8rpx;padding:4rpx 12rpx;vertical-align:2rpx}.meta{margin-top:16rpx}.foot{align-items:center;border-top:1rpx solid #f6f2ec;display:flex;justify-content:space-between;margin-top:18rpx;padding-top:16rpx}.foot .hot{color:#b4aa9c;font-size:22rpx}.foot .chev{color:#d8cfc2;font-size:32rpx}