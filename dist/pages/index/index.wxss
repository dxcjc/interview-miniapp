.home{padding:24rpx 24rpx 48rpx}.hm-top{align-items:center;display:flex;justify-content:space-between;padding:8rpx 8rpx 0}.hm-brand{font-size:34rpx;font-weight:900;letter-spacing:1rpx}.hm-brand .dot{color:#ff8a5c;margin:0 4rpx}.hm-avatar{align-items:center;background:#fff0e8;border-radius:50%;box-shadow:0 4rpx 12rpx rgba(93,66,42,.08);display:flex;font-size:40rpx;height:72rpx;justify-content:center;width:72rpx}.hm-hello{padding:24rpx 8rpx 4rpx}.hm-hello .hi{font-size:42rpx;font-weight:900}.hm-hello .hi .em{color:#ff7a45}.hm-hello .date{color:#a89f92;font-size:24rpx;margin-top:8rpx}.hm-count{background:linear-gradient(135deg,#fff0e8,#ffe3d3);border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(255,138,92,.25);margin-top:24rpx;padding:32rpx}.hm-count .label{color:#ff7a45;font-size:26rpx;font-weight:800}.hm-count .main{align-items:center;display:flex;justify-content:space-between;margin-top:24rpx}.hm-count .num{color:#2d2a26;font-family:Georgia,serif;font-size:96rpx;font-weight:900}.hm-count .num .unit{color:#4a453e;font-size:34rpx;font-weight:800;margin-left:8rpx}.ring-v{color:#ff7a45;font-size:40rpx;font-weight:900}.ring-t{color:#a89f92;font-size:22rpx;margin-top:4rpx}.hm-count .sub{color:#8a7f72;font-size:24rpx;margin-top:24rpx}.hm-count .jobs-link{color:#ff7a45;font-size:26rpx;font-weight:700;margin-top:8rpx}.hm-count .jobs-link .b{font-size:32rpx}.hm-task{align-items:center;display:flex;margin-bottom:16rpx}.hm-task .emoji{align-items:center;background:#fff0e8;border-radius:16rpx;display:flex;font-size:32rpx;height:64rpx;justify-content:center;width:64rpx}.hm-task .emoji.green{background:#e8f6ee}.hm-task .body{flex:1;margin-left:20rpx}.hm-task .name{font-size:28rpx;font-weight:700}.hm-task .sub{color:#a89f92;font-size:22rpx;margin-top:4rpx}.hm-task .arrow{color:#b4aa9c;font-size:32rpx}.hm-task .arrow.ok{color:#4caf7d}.hm-task.done .name{color:#a89f92;text-decoration:line-through}.hm-task-empty{padding:48rpx 0}.hm-stats{background:#fff;border-radius:20rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.06);display:flex;margin-top:20rpx;padding:28rpx 0}.hm-stat{flex:1;text-align:center}.hm-stat .v{font-family:Georgia,serif;font-size:44rpx;font-weight:900}.hm-stat .v .sup{color:#a89f92;font-size:22rpx;font-weight:600;margin-left:4rpx}.hm-stat .k{color:#a89f92;font-size:22rpx;margin-top:4rpx}.hm-know-card{padding-bottom:12rpx;padding-top:8rpx}.hm-krow{margin-top:20rpx}.hm-krow .top{display:flex;font-size:26rpx;justify-content:space-between;margin-bottom:8rpx}.hm-krow .n{color:#4a453e;font-weight:600}.hm-krow .p{color:#a89f92}.hm-krow .bar{background:#f3ede6;border-radius:999rpx;height:16rpx;overflow:hidden}.hm-krow .bar .fill{border-radius:999rpx;height:100%}.hm-krow .bar .fill.low{background:#ff9f43}.hm-krow .bar .fill.mid{background:#ff8a5c}.hm-krow .bar .fill.high{background:#4caf7d}.hm-know-empty{color:#a89f92;font-size:26rpx;padding:40rpx 0;text-align:center}