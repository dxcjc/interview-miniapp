.home{padding:28rpx 48rpx 96rpx}.hm-top{align-items:center;display:flex;justify-content:space-between;padding:8rpx 0 0}.hm-brand{color:#2d2a26;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:44rpx;font-weight:900;letter-spacing:1rpx}.hm-brand .dot{color:#ff8a5c;margin:0 4rpx}.hm-avatar{align-items:center;background:#fff;border-radius:50%;box-shadow:0 12rpx 36rpx rgba(255,138,92,.35);display:flex;font-size:40rpx;height:84rpx;justify-content:center;width:84rpx}.hm-hello{padding:20rpx 0 0}.hm-hello .hi{color:#2d2a26;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:42rpx;font-weight:900}.hm-hello .hi .em{color:#ff7a45}.hm-hello .date{color:#a89f92;font-size:22rpx;font-weight:600;margin-top:10rpx}.hm-count{background:linear-gradient(145deg,#fff9f2,#ffefe3);border-radius:52rpx;box-shadow:0 24rpx 72rpx rgba(255,138,92,.18);margin-top:32rpx;overflow:hidden;padding:40rpx 44rpx;position:relative}.hm-count::after{background:rgba(255,138,92,.1);border-radius:50%;content:"";height:220rpx;position:absolute;right:-68rpx;top:-60rpx;width:220rpx}.hm-count .label{align-items:center;color:#ff7a45;display:flex;font-size:23rpx;font-weight:800;letter-spacing:2rpx}.hm-count .main{align-items:center;display:flex;justify-content:space-between;margin-top:24rpx;position:relative;z-index:1}.hm-count .num{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:128rpx;font-weight:900;letter-spacing:-4rpx;line-height:1}.hm-count .num .unit{color:#c98a68;font-size:30rpx;font-weight:800;letter-spacing:0;margin-left:8rpx}.ring-v{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:30rpx;font-weight:900;line-height:1}.ring-t{color:#c9a48c;font-size:16rpx;font-weight:700;margin-top:4rpx}.hm-count .sub{color:#b08d74;font-size:21rpx;font-weight:600;line-height:1.8;margin-top:28rpx;position:relative;z-index:1}.hm-count .jobs-link{color:#ff7a45;font-size:26rpx;font-weight:700;margin-top:8rpx}.hm-count .jobs-link .b{font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:32rpx;font-weight:900}.hm-task{align-items:center;background:#fff;border-radius:32rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;gap:24rpx;margin-bottom:20rpx;padding:26rpx 28rpx}.hm-task .emoji{align-items:center;background:#fff0e8;border-radius:24rpx;display:flex;flex-shrink:0;font-size:36rpx;height:76rpx;justify-content:center;width:76rpx}.hm-task .emoji.green{background:#e8f6ee}.hm-task .body{flex:1;min-width:0}.hm-task .name{color:#2d2a26;font-size:25rpx;font-weight:800}.hm-task .sub{color:#b4aa9c;font-size:20rpx;font-weight:600;margin-top:6rpx}.hm-task .arrow{color:#d5cdc2;flex-shrink:0;font-size:32rpx;font-weight:800}.hm-task .arrow.ok{color:#4caf7d}.hm-task.done .name{color:#a89f92;text-decoration:line-through}.hm-task-empty{padding:40rpx 16rpx}.hm-stats{background:#fff;border-radius:44rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;margin-top:12rpx;overflow:hidden}.hm-stat{flex:1;padding:32rpx 16rpx;position:relative;text-align:center}.hm-stat + .hm-stat::before{background:#f0ebe3;bottom:26%;content:"";left:0;position:absolute;top:26%;width:1rpx}.hm-stat .v{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:52rpx;font-weight:900;line-height:1}.hm-stat .v .sup{color:#b4aa9c;font-size:22rpx;font-weight:700;margin-left:4rpx}.hm-stat .k{color:#6b635a;font-size:21rpx;font-weight:700;margin-top:10rpx}.hm-know-card{padding:12rpx 32rpx}.hm-krow{padding:24rpx 0}.hm-krow + .hm-krow{border-top:1rpx dashed #f0ebe3}.hm-krow .top{align-items:baseline;display:flex;justify-content:space-between;margin-bottom:14rpx}.hm-krow .n{color:#4a453e;font-size:24rpx;font-weight:700}.hm-krow .p{color:#ff7a45;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,