.settings{padding-top:0}.set-group{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:32rpx;overflow:hidden}.set-row{align-items:center;border-bottom:1rpx dashed #f0ebe3;display:flex;gap:24rpx;justify-content:space-between;padding:32rpx 36rpx}.set-row:last-child{border-bottom:none}.set-label{color:#2d2a26;font-size:26rpx;font-weight:800}.set-value{color:#b4aa9c;font-size:24rpx}.set-arrow{color:#d5cdc2;font-size:30rpx;font-weight:700}.set-api{color:#b4aa9c;font-size:22rpx;line-height:1.6;padding:8rpx 36rpx 32rpx;word-break:break-all}.set-note{color:#b4aa9c;font-size:22rpx;line-height:1.7;padding:20rpx 12rpx}