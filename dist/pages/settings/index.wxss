.st-card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);overflow:hidden}.st-row{align-items:center;display:flex;gap:24rpx;padding:32rpx}.st-row + .st-row{border-top:2rpx dashed #f0ebe3}.st-info{flex:1;min-width:0}.st-info .k{color:#2d2a26;font-size:26rpx;font-weight:800}.st-info .s{color:#b4aa9c;font-size:20rpx;font-weight:600;margin-top:6rpx}.st-seg{background:#f5f1ea;border-radius:9999rpx;display:flex;flex-shrink:0;gap:8rpx;padding:6rpx}.st-seg view{border-radius:9999rpx;color:#8a8072;font-size:21rpx;font-weight:800;padding:14rpx 26rpx;transition:all .2s}.st-seg view.on{background:#ff8a5c;box-shadow:0 8rpx 24rpx rgba(255,138,92,.35);color:#fff}.st-switch{background:#e0d9ce;border-radius:9999rpx;flex-shrink:0;height:54rpx;position:relative;transition:background .2s;width:92rpx}.st-switch .knob{background:#fff;border-radius:50%;box-shadow:0 4rpx 12rpx rgba(93,66,42,.25);height:42rpx;left:6rpx;position:absolute;top:6rpx;transition:left .2s;width:42rpx}.st-switch.on{background:#ff8a5c}.st-switch.on .knob{left:44rpx}.st-ver{color:#b4aa9c;flex-shrink:0;font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:26rpx;font-weight:900}