.interview{padding:28rpx 48rpx 96rpx}.iv-title{color:#2d2a26;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:40rpx;font-weight:900;padding:8rpx 0 0}.iv-sub{color:#a89f92;font-size:22rpx;padding:8rpx 0 0}.iv-modes{margin-top:28rpx}.iv-mode{align-items:center;background:#fff;border-radius:44rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;gap:24rpx;margin-bottom:20rpx;padding:28rpx}.iv-mode.on{background:#fff0e8;border:2rpx solid #ff8a5c}.iv-mode-icon{align-items:center;background:#ff8a5c;border-radius:24rpx;display:flex;flex-shrink:0;font-size:36rpx;height:72rpx;justify-content:center;width:72rpx}.iv-mode-body{flex:1;min-width:0}.iv-mode-name{color:#2d2a26;font-size:26rpx;font-weight:800}.iv-mode-sub{color:#a89f92;font-size:19rpx;margin-top:4rpx}.iv-mode-check{color:#ff7a45;flex-shrink:0;font-size:32rpx;font-weight:900}.iv-dir-label{color:#2d2a26;font-size:28rpx;font-weight:800;margin:32rpx 0 16rpx}.iv-dirs{display:flex;flex-wrap:wrap;gap:16rpx}.iv-dir{background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;font-size:22rpx;font-weight:700;padding:18rpx 34rpx}.iv-dir.on{background:#ff8a5c;box-shadow:0 8rpx 28rpx rgba(255,138,92,.4);color:#fff}.iv-start{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 24rpx 64rpx rgba(255,122,69,.28);color:#fff;font-size:28rpx;font-weight:900;height:112rpx;line-height:112rpx;margin-top:48rpx;text-align:center}.iv-start.loading{background:#e8e0d6;box-shadow:none}.iv-session-error{margin-top:20rpx}.chat{background:linear-gradient(180deg,#fbf8f3,#f5efe7);box-sizing:border-box;display:flex;flex-direction:column;height:100vh}.chat-head{align-items:center;display:flex;justify-content:space-between;padding:28rpx 48rpx 8rpx}.chat-mode{color:#ff7a45;font-size:22rpx;font-weight:800;letter-spacing:2rpx}.chat-end{background:#ffe9e9;border-radius:9999rpx;color:#ff5d5d;font-size:22rpx;font-weight:700;padding:10rpx 26rpx}.chat-body{box-sizing:border-box;flex:1;height:0;padding:0 48rpx}.chat-tip{color:#b4aa9c;font-size:22rpx;padding:24rpx 0 40rpx;text-align:center}.msg-row{align-items:flex-end;display:flex;gap:16rpx;margin-bottom:28rpx}.msg-row.mine{flex-direction:row-reverse}.msg-avatar{align-items:center;background:#fff0e8;border-radius:50%;display:flex;flex-shrink:0;font-size:30rpx;height:60rpx;justify-content:center;width:60rpx}.msg-row.mine .msg-avatar{background:#ffe9e0}.msg-bubble{background:#fff;border-radius:12rpx 36rpx 36rpx 36rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);color:#2d2a26;font-size:25rpx;line-height:1.7;max-width:78%;padding:22rpx 28rpx;word-break:break-all}.msg-row.mine .msg-bubble{background:linear-gradient(145deg,#ff9a6c,#ff7a45);border-radius:36rpx 12rpx 36rpx 36rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff}.msg-bubble.thinking{color:#a89f92;font-size:24rpx}.caret{-webkit-animation:blink .8s infinite;animation:blink .8s infinite;background:#ff7a45;display:inline-block;height:24rpx;margin-left:4rpx;vertical-align:-2rpx;width:4rpx}.msg-row.mine .caret{background:#fff}@-webkit-keyframes blink{0%,100%{opacity:1}50%{opacity:0}}@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}.turn-error{color:#ff5d5d;font-size:21rpx;font-weight:700;padding:8rpx 0;text-align:center}.chat-input-bar{align-items:flex-end;display:flex;gap:20rpx;padding:16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));position:relative}.rec-indicator{align-items:center;background:rgba(45,42,38,.85);border-radius:9999rpx;color:#fff;display:flex;font-size:22rpx;left:50%;padding:20rpx 36rpx;position:absolute;top:-136rpx;-webkit-transform:translateX(-50%);transform:translateX(-50%);white-space:nowrap;z-index:5}.rec-dot{-webkit-animation:blink .8s infinite;animation:blink .8s infinite;background:#ff5d5d;border-radius:50%;height:16rpx;margin-right:12rpx;width:16rpx}.rec-dot.trans{background:#ff8a5c}.chat-mic{align-items:center;background:#fff;border-radius:50%;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;flex-shrink:0;font-size:34rpx;height:88rpx;justify-content:center;width:88rpx}.chat-mic.rec{background:#fff0e8;box-shadow:0 0 0 6rpx rgba(255,93,93,.12)}.chat-input{background:#fff;border-radius:9999rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);box-sizing:border-box;flex:1;font-size:26rpx;max-height:200rpx;min-height:88rpx;padding:24rpx 32rpx}.chat-send{background:#ff8a5c;border-radius:50%;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;flex-shrink:0;font-size:24rpx;font-weight:900;padding:20rpx 28rpx}.chat-send.disabled{background:#e8e0d6;box-shadow:none}.modal-mask{align-items:center;background:rgba(45,42,38,.45);display:flex;inset:0;justify-content:center;padding:48rpx;position:fixed;z-index:99}.modal{background:#fff;border-radius:44rpx;box-shadow:0 24rpx 80rpx rgba(93,66,42,.18);max-width:560rpx;padding:44rpx 40rpx 36rpx;text-align:center;width:100%}.modal-title{color:#2d2a26;font-size:30rpx;font-weight:900}.modal-sub{color:#a89f92;font-size:22rpx;margin-top:12rpx}.modal-actions{display:flex;gap:20rpx;margin-top:32rpx}.modal-btn{border-radius:9999rpx;flex:1;font-size:24rpx;font-weight:800;padding:20rpx 0;text-align:center}.modal-btn.ghost{background:#f5f1ea;color:#8a8072}.modal-btn.solid{background:#ff8a5c;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff}