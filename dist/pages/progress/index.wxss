.skeleton{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);margin-bottom:20rpx;padding:32rpx 36rpx}.skeleton .sk-line{-webkit-animation:sk-shimmer 1.4s infinite;animation:sk-shimmer 1.4s infinite;background:linear-gradient(90deg,#f5f1ea 25%,#fbf8f3 50%,#f5f1ea 75%);background-size:200% 100%;border-radius:12rpx;height:26rpx}.skeleton .sk-line.short{width:52%}.skeleton .sk-row{display:flex;gap:16rpx;margin-top:24rpx}.skeleton .sk-tag{-webkit-animation:sk-shimmer 1.4s infinite;animation:sk-shimmer 1.4s infinite;background:#f5f1ea;border-radius:9999rpx;height:32rpx;width:92rpx}@-webkit-keyframes sk-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}@keyframes sk-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}.state-box{color:#a89f92;font-size:24rpx;line-height:1.9;padding:88rpx 48rpx;text-align:center}.state-box .state-icon{height:68rpx;margin:0 auto 20rpx;width:68rpx}.state-box .state-icon image{height:100%;width:100%}.state-box .retry-btn{background:#ff8a5c;border-radius:9999rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;display:inline-block;font-size:24rpx;font-weight:700;margin-top:28rpx;padding:18rpx 44rpx}.pg-sk{padding:32rpx}.pg-card{background:#fff;border-radius:48rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);padding:28rpx}.pg-chart{align-items:flex-end;display:flex;gap:16rpx;height:520rpx;width:100%}.pg-col{align-items:center;display:flex;flex:1;flex-direction:column;height:100%}.pg-col-v{color:#4a453e;font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:20rpx;font-weight:800;margin-bottom:8rpx}.pg-col-bar-wrap{align-items:flex-end;display:flex;flex:1;justify-content:center;width:100%}.pg-col-bar{border-radius:16rpx 16rpx 0 0;min-height:6rpx;width:60%}.pg-col-bar.low{background:linear-gradient(180deg,#ffb28f,#ff9f43)}.pg-col-bar.mid{background:linear-gradient(180deg,#ffb28f,#ff8a5c)}.pg-col-bar.high{background:linear-gradient(180deg,#7bc69b,#4caf7d)}.pg-col-date{color:#b4aa9c;font-size:20rpx;margin-top:12rpx}.pg-stats{background:#fff;border-radius:44rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;overflow:hidden}.pg-stat{flex:1;padding:32rpx 8rpx;position:relative;text-align:center}.pg-stat + .pg-stat::before{background:#f0ebe3;bottom:24%;content:"";left:0;position:absolute;top:24%;width:2rpx}.pg-stat .v{color:#ff7a45;font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:44rpx;font-weight:900;line-height:1}.pg-stat .v .small{color:#b4aa9c;font-size:20rpx;font-weight:700;margin-left:2rpx}.pg-stat .v.sub{color:#4a453e;font-size:36rpx}.pg-stat .k{color:#a89f92;font-size:20rpx;font-weight:700;margin-top:12rpx}