.progress{padding-top:8rpx}.pg-stats{display:flex}.pg-stat{flex:1;text-align:center}.pg-v{font-family:Georgia,serif;font-size:44rpx;font-weight:900}.pg-k{color:#a89f92;font-size:22rpx;margin-top:4rpx}.pg-chart{align-items:flex-end;display:flex;gap:8rpx;height:280rpx;padding-bottom:30rpx;padding-top:40rpx}.pg-col{align-items:center;display:flex;flex:1;flex-direction:column;height:100%}.pg-col-v{font-size:20rpx;font-weight:800;margin-bottom:8rpx}.pg-col-bar-wrap{align-items:flex-end;display:flex;flex:1;justify-content:center;width:100%}.pg-col-bar{border-radius:8rpx 8rpx 0 0;min-height:6rpx;width:60%}.pg-col-bar.low{background:#ff9f43}.pg-col-bar.mid{background:#ff8a5c}.pg-col-bar.high{background:#4caf7d}.pg-col-date{color:#b4aa9c;font-size:20rpx;margin-top:8rpx}.pg-item{align-items:center;display:flex;justify-content:space-between;margin-bottom:14rpx}.pg-item-type{font-size:27rpx;font-weight:700}.pg-item-date{color:#a89f92;font-size:22rpx;margin-top:6rpx}.pg-item-score{font-family:Georgia,serif;font-size:40rpx;font-weight:900}.pg-item-score.low{color:#ff9f43}.pg-item-score.mid{color:#ff7a45}.pg-item-score.high{color:#4caf7d}