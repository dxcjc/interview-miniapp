.plan{padding-top:0}.plan-prog{background:linear-gradient(145deg,#fff9f2,#ffefe3);border-radius:48rpx;box-shadow:0 24rpx 80rpx rgba(255,138,92,.18);padding:44rpx 48rpx}.plan-prog-top{align-items:center;display:flex;gap:16rpx;justify-content:space-between}.plan-prog-title{color:#2d2a26;font-family:"Noto Serif SC",Songti SC,STSong,SimSun,serif;font-size:32rpx;font-weight:900}.plan-prog-dir{background:hsla(0,0%,100%,.6);border-radius:9999rpx;color:#c98a68;font-size:20rpx;font-weight:700;padding:8rpx 24rpx;white-space:nowrap}.plan-prog-mid{align-items:center;display:flex;margin-top:28rpx}.plan-prog-bar{background:#ffe3d3;border-radius:16rpx;flex:1;height:20rpx;overflow:hidden}.plan-prog-fill{background:linear-gradient(90deg,#ffb28f,#ff8a5c);border-radius:16rpx;height:100%;transition:width .3s}.plan-prog-num{color:#ff9a6c;font-family:Nunito,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:24rpx;font-weight:800;margin-left:24rpx;white-space:nowrap}.plan-prog-date{color:#b08d74;display:block;font-size:22rpx;font-weight:600;margin-top:20rpx}.plan-weeks{display:flex;gap:16rpx;margin:32rpx 0}.plan-week-tab{background:#fff;border-radius:9999rpx;box-shadow:0 4rpx 16rpx rgba(93,66,42,.05);color:#8a8072;flex:1;font-size:22rpx;font-weight:700;padding:20rpx 0;text-align:center}.plan-week-tab.on{background:#ff8a5c;box-shadow:0 8rpx 28rpx rgba(255,138,92,.4);color:#fff}.plan-grid{padding:24rpx}.plan-cell{align-items:center;background:#fbf8f3;border-radius:26rpx;display:flex;flex-direction:column;height:156rpx;justify-content:center;position:relative}.plan-cell-day{color:#6b635a;font-size:20rpx;font-weight:800}.plan-cell-topic{font-size:28rpx;margin-top:12rpx}.plan-cell-check{color:#4caf7d;font-size:22rpx;font-weight:900;position:absolute;right:16rpx;top:12rpx}.plan-cell.done{background:#f0faf4}.plan-cell.done .plan-cell-day{color:#4caf7d}.plan-detail{align-items:center;background:#fff;border-radius:40rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);display:flex;justify-content:space-between;margin-top:32rpx;padding:32rpx 36rpx}.plan-detail-left{flex:1;margin-right:24rpx;min-width:0}.plan-detail-day{color:#a89f92;font-size:22rpx;font-weight:700}.plan-detail-topic{color:#2d2a26;font-size:30rpx;font-weight:800;line-height:1.5;margin-top:12rpx}.plan-detail-type{background:#fff0e8;border-radius:9999rpx;color:#ff7a45;display:inline-block;font-size:20rpx;font-weight:700;margin-top:14rpx;padding:8rpx 22rpx}.plan-detail-btn{background:#ff8a5c;border-radius:28rpx;box-shadow:0 16rpx 48rpx rgba(255,138,92,.25);color:#fff;flex-shrink:0;font-size:24rpx;font-weight:800;padding:22rpx 30rpx}.plan-detail.done .plan-detail-btn{background:#4caf7d}