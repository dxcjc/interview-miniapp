.plan{padding-top:8rpx}.plan-prog-top{align-items:center;display:flex;justify-content:space-between}.plan-prog-title{font-size:32rpx;font-weight:900}.plan-prog-dir{background:#fff0e8;border-radius:999rpx;color:#ff7a45;font-size:22rpx;font-weight:700;padding:6rpx 20rpx}.plan-prog-mid{align-items:center;display:flex;margin-top:24rpx}.plan-prog-bar{background:#f3ede6;border-radius:999rpx;flex:1;height:20rpx;overflow:hidden}.plan-prog-fill{background:linear-gradient(90deg,#ff9a6c,#ff8a5c);border-radius:999rpx;height:100%;transition:width .3s}.plan-prog-num{color:#4a453e;font-size:24rpx;font-weight:800;margin-left:16rpx;white-space:nowrap}.plan-prog-date{color:#a89f92;display:block;font-size:22rpx;margin-top:14rpx}.plan-weeks{display:flex;gap:12rpx;margin:20rpx 0}.plan-week-tab{background:#fff;border-radius:14rpx;box-shadow:0 4rpx 12rpx rgba(93,66,42,.05);color:#a89f92;flex:1;font-size:24rpx;font-weight:700;padding:16rpx 0;text-align:center}.plan-week-tab.on{background:#ff8a5c;box-shadow:0 8rpx 24rpx rgba(255,138,92,.32);color:#fff}.plan-grid{display:grid;gap:12rpx;grid-template-columns:repeat(7,1fr)}.plan-cell{align-items:center;aspect-ratio:.82;background:#fbf8f3;border:2rpx solid transparent;border-radius:14rpx;display:flex;flex-direction:column;justify-content:center;position:relative}.plan-cell-day{color:#4a453e;font-size:22rpx;font-weight:800}.plan-cell-topic{font-size:26rpx;margin-top:8rpx}.plan-cell-check{color:#4caf7d;font-size:18rpx;font-weight:900;position:absolute;right:8rpx;top:6rpx}.plan-cell.done{background:#e8f6ee;border-color:#cfe8d9}.plan-cell.done .plan-cell-day{color:#4caf7d}.plan-detail{align-items:center;display:flex;justify-content:space-between;margin-top:20rpx}.plan-detail-left{flex:1;margin-right:16rpx}.plan-detail-day{color:#a89f92;font-size:22rpx;font-weight:700}.plan-detail-topic{font-size:30rpx;font-weight:800;line-height:1.5;margin-top:8rpx}.plan-detail-type{background:#fff0e8;border-radius:999rpx;color:#ff7a45;display:inline-block;font-size:22rpx;font-weight:700;margin-top:10rpx;padding:6rpx 18rpx}.plan-detail-btn{background:#ff8a5c;border-radius:14rpx;color:#fff;flex-shrink:0;font-size:24rpx;font-weight:800;padding:18rpx 26rpx}.plan-detail.done .plan-detail-btn{background:#4caf7d}