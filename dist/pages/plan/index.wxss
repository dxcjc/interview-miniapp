.plan-top{background:linear-gradient(145deg,#fff9f2,#ffefe3);border-radius:48rpx;box-shadow:0 24rpx 80rpx rgba(255,138,92,.18);margin:32rpx 0 0;padding:44rpx 48rpx}.plan-top .row{align-items:baseline;display:flex;justify-content:space-between}.plan-top .p{color:#c98a68;font-size:24rpx;font-weight:700;letter-spacing:2rpx}.plan-top .num{color:#ff7a45;font-family:DIN Alternate,Arial Rounded MT Bold,Arial,-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Microsoft YaHei,sans-serif;font-size:84rpx;font-weight:900;line-height:1}.plan-top .sub{color:#ff9a6c;font-size:23rpx;font-weight:800}.plan-top .bar{background:#ffe3d3;border-radius:16rpx;height:20rpx;margin-top:28rpx;overflow:hidden}.plan-top .bar > view{background:linear-gradient(90deg,#ffb28f,#ff8a5c);border-radius:16rpx;display:block;height:100%;transition:width .3s}.plan-top .desc{color:#b08d74;font-size:22rpx;font-weight:500;margin-top:24rpx}.plan-timeline{padding:52rpx 0 0;position:relative}.plan-timeline::before{background:repeating-linear-gradient(180deg,#e8e0d6 0 8rpx,transparent 8rpx 16rpx);bottom:68rpx;content:"";left:94rpx;position:absolute;top:68rpx;width:4rpx}.week-row{display:flex;gap:24rpx;margin-bottom:48rpx;min-width:0;position:relative}.week-node{align-items:center;display:flex;flex-direction:column;flex-shrink:0;width:76rpx}.week-node .dot{align-items:center;background:#ff8a5c;border-radius:50%;box-shadow:0 8rpx 24rpx rgba(255,138,92,.35);color:#fff;display:flex;font-size:22rpx;font-weight:900;height:72rpx;justify-content:center;width:72rpx}.week-node .dot.done{background:#4caf7d;box-shadow:0 8rpx 24rpx rgba(76,175,125,.3)}.week-node .dot.wait{background:#e8e0d6;box-shadow:none;color:#a89f92}.week-card{background:#fff;border-radius:44rpx;box-shadow:0 8rpx 32rpx rgba(93,66,42,.06);flex:1;min-width:0;padding:36rpx}.week-card.cur{border:3rpx solid #ffb28f}.week-card .w-head{align-items:center;display:flex;justify-content:space-between;margin-bottom:28rpx}.week-card .w-name{font-size:28rpx;font-weight:900}.week-card .w-date{color:#b4aa9c;font-size:20rpx;font-weight:600;white-space:nowrap}.week-card .w-date .arr{font-size:18rpx;margin-left:8rpx}.week-grid{display:flex;gap:16rpx;overflow-x:auto;padding-bottom:10rpx;width:100%}.week-day{align-items:center;background:#fbf8f3;border-radius:26rpx;display:flex;flex:0 0 156rpx;flex-direction:column;gap:8rpx;min-width:0;padding:20rpx 8rpx;position:relative;transition:-webkit-transform .15s;transition:transform .15s;transition:transform .15s,-webkit-transform .15s}.week-day:active{-webkit-transform:scale(.96);transform:scale(.96)}.week-day .d{color:#b4aa9c;font-size:20rpx;font-weight:800}.week-day .n{color:#6b635a;display:block;font-size:22rpx;font-weight:700;line-height:1.3;min-height:32rpx;text-align:center;white-space:nowrap}.week-day .st{align-items:center;border:3rpx solid #d5cdc2;border-radius:50%;color:#fff;display:flex;font-size:20rpx;height:36rpx;justify-content:center;width:36rpx}.week-day.done{background:#f0faf4}.week-day.done .st{background:#4caf7d;border-color:#4caf7d}.week-day.today{background:#fff7f1;border:3rpx solid #ff8a5c}.week-day.today .st{background:#ff8a5c;border-color:#ff8a5c}.week-day.today .n{color:#ff7a45;font-weight:900}.week-day.today .today-tag{background:#ff8a5c;border-radius:9999rpx;color:#fff;font-size:14rpx;font-weight:900;left:50%;padding:3rpx 14rpx;position:absolute;top:-14rpx;-webkit-transform:translateX(-50%);transform:translateX(-50%);white-space:nowrap}.plan-flash{background:#ffe9e9;border-radius:24rpx;color:#ff5d5d;font-size:21rpx;font-weight:700;margin:24rpx 0 0;padding:20rpx 28rpx;text-align:center}.plan-top-sk{padding:44rpx 48rpx}.week-sk{padding:36rpx}